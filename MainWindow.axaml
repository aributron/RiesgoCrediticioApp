<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RiesgoFiscalApp.MainWindow"
        Title="Evaluación de riesgo crediticio" Height="900" Width="1200"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Inter, Segoe UI, sans-serif">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource InputForeground}" />
        </Style>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}" />
        </Style>
    </Window.Styles>
    <Grid ColumnDefinitions="260,*" Background="{DynamicResource ShellBackground}">
        <Border Background="{DynamicResource SidebarBackground}" Padding="24">
            <StackPanel Spacing="24">
                <StackPanel>
                    <TextBlock Text="Riesgo crediticio" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SidebarPrimaryText}" />
                    <TextBlock Text="Créditos personales" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource SidebarSecondaryText}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <ToggleButton Classes="MenuButton" Content="Dashboard" IsChecked="{Binding IsDashboardSection, Mode=TwoWay}" />
                    <ToggleButton Classes="MenuButton" Content="Solicitudes" IsChecked="{Binding IsApplicationsSection, Mode=TwoWay}" />
                    <ToggleButton Classes="MenuButton" Content="Evaluación" IsChecked="{Binding IsEvaluationSection, Mode=TwoWay}" />
                    <ToggleButton Classes="MenuButton" Content="Configuración" IsChecked="{Binding IsConfiguracionSection, Mode=TwoWay}" />
                </StackPanel>
                <Border Background="{DynamicResource PanelBackground}" CornerRadius="14" Padding="16">
                    <TextBlock Text="Prototipo académico&#10;Evaluación mediante Machine Learning" TextWrapping="Wrap" Foreground="{DynamicResource SidebarPrimaryText}" />
                </Border>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Background="{DynamicResource TopBarBackground}" Padding="22" Margin="20" CornerRadius="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding SelectedSection}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PageForeground}" />
                    <TextBlock Text="Solicitudes de personas físicas en relación de dependencia." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" />
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" Margin="20,0,20,20" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20">
                    <Border Background="{DynamicResource MainPanelBackground}" CornerRadius="18" Padding="24" IsVisible="{Binding IsDashboardSection}">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Resumen de la sesión" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PageForeground}" />
                            <Grid ColumnDefinitions="*,*">
                                <Border Background="{DynamicResource CardBackground}" CornerRadius="14" Padding="18" Margin="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock Text="Solicitudes iniciadas" Foreground="{DynamicResource SecondaryForeground}" />
                                        <TextBlock Text="{Binding ApplicationCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PageForeground}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource CardBackground}" CornerRadius="14" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Con evaluación vigente" Foreground="{DynamicResource SecondaryForeground}" />
                                        <TextBlock Text="{Binding EvaluatedCount}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PageForeground}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="Los datos se mantienen únicamente durante esta sesión y se pierden al cerrar la aplicación." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource MainPanelBackground}" CornerRadius="18" Padding="24" IsVisible="{Binding IsApplicationsSection}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Solicitudes de la sesión" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PageForeground}" />
                            <TextBlock Text="Incluye la solicitud en edición. Las solicitudes anteriores se conservan como referencia durante la sesión." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" />
                            <Button Classes="Primary" Content="Nueva solicitud" Command="{Binding NewApplicationCommand}" />
                            <ItemsControl ItemsSource="{Binding Applications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackground}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Solicitante.Nombre}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PageForeground}" />
                                                <TextBlock Text="{Binding Solicitante.Dni, StringFormat='DNI: {0}'}" Foreground="{DynamicResource SecondaryForeground}" />
                                                <TextBlock Text="{Binding Id, StringFormat='Solicitud: {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource SubtleForeground}" />
                                                <TextBlock Text="{Binding Estado}" Foreground="{DynamicResource PageForeground}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBackground}" CornerRadius="18" Padding="24" IsVisible="{Binding IsEvaluationSection}">
                        <StackPanel Spacing="18">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Solicitud de crédito personal" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PageForeground}" />
                                    <TextBlock Text="{Binding CurrentApplication.Id}" FontSize="11" Foreground="{DynamicResource SubtleForeground}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Nueva solicitud" Command="{Binding NewApplicationCommand}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="1. Datos declarados por el solicitante" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{DynamicResource PageForeground}" />
                                    <Label Content="Nombre y apellido" />
                                    <TextBox Text="{Binding CurrentCustomer.Nombre, Mode=TwoWay}" Watermark="Ej.: María García" />
                                    <Label Content="DNI (sin puntos)" />
                                    <TextBox Text="{Binding CurrentCustomer.Dni, Mode=TwoWay}" Watermark="Ej.: 30123456" />
                                    <Label Content="Edad (años)" />
                                    <TextBox Text="{Binding AgeInput, Mode=TwoWay}" Watermark="Ej.: 35" />
                                    <Label Content="Situación laboral" />
                                    <TextBox Text="{Binding CurrentCustomer.SituacionLaboral, Mode=OneWay}" IsReadOnly="True" />
                                    <Label><TextBlock Text="Ingreso bruto mensual declarado (ARS)" TextWrapping="Wrap" /></Label>
                                    <TextBox Text="{Binding IncomeInput, Mode=TwoWay}" Watermark="Ej.: 850000,50" />
                                    <Label><TextBlock Text="Compromisos y gastos mensuales declarados (ARS)" TextWrapping="Wrap" /></Label>
                                    <TextBox Text="{Binding CommitmentsInput, Mode=TwoWay}" Watermark="Ej.: 420000" />
                                    <TextBlock Text="Incluye pagos de deudas, obligaciones alimentarias y gastos habituales de vida. No incluyas la cuota hipotética del crédito solicitado." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,12" />
                                    <TextBlock Text="Atrasos históricos declarados — últimos 24 meses" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource PageForeground}" />
                                    <Label><TextBlock Text="Cantidad de atrasos de 30–59 días (últimos 24 meses)" TextWrapping="Wrap" /></Label>
                                    <TextBox Text="{Binding Late30Input, Mode=TwoWay}" Watermark="Entero entre 0 y 24" />
                                    <Label><TextBlock Text="Cantidad de atrasos de 60–89 días (últimos 24 meses)" TextWrapping="Wrap" /></Label>
                                    <TextBox Text="{Binding Late60Input, Mode=TwoWay}" Watermark="Entero entre 0 y 24" />
                                    <TextBlock Text="Datos declarados para esta implementación académica. Si desconocés un dato, dejalo pendiente; no ingreses cero. En un entorno real, el historial debería provenir de fuentes externas de información crediticia." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,12" />
                                    <Label Content="Monto solicitado (ARS)" />
                                    <TextBox Text="{Binding AmountInput, Mode=TwoWay}" Watermark="Ej.: 1500000" />
                                    <Label Content="Plazo (meses)" />
                                    <TextBox Text="{Binding TermInput, Mode=TwoWay}" Watermark="Ej.: 12" />
                                    <TextBlock Text="Monto y plazo se registran en la solicitud, pero no intervienen en el modelo inicial." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubtleForeground}" Margin="0,0,0,10" />
                                    <TextBlock Text="Importes sin separador de miles; usá coma para los decimales." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubtleForeground}" />
                                </StackPanel>
                                <StackPanel Spacing="15" Grid.Column="1">
                                    <TextBlock Text="2. Documentación" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PageForeground}" />
                                    <TextBlock Text="Adjuntá recibos de sueldo PDF con texto embebido. Al procesar cada recibo, su texto se envía a OpenAI para extraer los campos financieros. Los datos declarados se mantienen separados." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" />
                                    <Button Content="Adjuntar recibos de sueldo (PDF)" Command="{Binding AddDocumentCommand}" HorizontalAlignment="Stretch" />
                                    <ItemsControl ItemsSource="{Binding Documents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BorderPanelBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                    <StackPanel Spacing="10">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Tipo}" FontWeight="SemiBold" Foreground="{DynamicResource PageForeground}" />
                                                            <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ProcessingStatusText, StringFormat='Procesamiento: {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource PageForeground}" />
                                                        <TextBlock Text="{Binding ProcessingMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="Procesar recibo"
                                                                Command="{Binding $parent[Window].DataContext.ProcessDocumentCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Quitar"
                                                                Command="{Binding $parent[Window].DataContext.RemoveDocumentCommand}"
                                                                CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                        <Border IsVisible="{Binding HasFinancialData}" BorderBrush="#2563EB" BorderThickness="2,0,0,0" Padding="12" Background="{DynamicResource CardBackground}" CornerRadius="4">
                                                            <StackPanel Spacing="6">
                                                                <TextBlock Text="Datos extraídos del recibo (solo lectura)" TextWrapping="Wrap" FontWeight="Bold" Foreground="{DynamicResource PageForeground}" />
                                                                <TextBlock Text="{Binding ReviewStatus, StringFormat='Revisión: {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryForeground}" />
                                                                <TextBlock Text="Empleador" FontSize="12" Foreground="{DynamicResource SubtleForeground}" />
                                                                <TextBlock Text="{Binding FinancialData.Employer, TargetNullValue='No obtenido'}" TextWrapping="Wrap" Foreground="{DynamicResource PageForeground}" />
                                                                <TextBlock Text="Ingreso bruto (ARS)" FontSize="12" Foreground="{DynamicResource SubtleForeground}" />
                                                                <TextBlock Text="{Binding FinancialData.GrossIncome, StringFormat='{}{0:N2}', TargetNullValue='No obtenido'}" Foreground="{DynamicResource PageForeground}" />
                                                                <TextBlock Text="Ingreso neto (ARS)" FontSize="12" Foreground="{DynamicResource SubtleForeground}" />
                                                                <TextBlock Text="{Binding FinancialData.NetIncome, StringFormat='{}{0:N2}', TargetNullValue='No obtenido'}" Foreground="{DynamicResource PageForeground}" />
                                                                <TextBlock Text="Fecha del recibo" FontSize="12" Foreground="{DynamicResource SubtleForeground}" />
                                                                <TextBlock Text="{Binding FinancialData.ReceiptDate, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue='No obtenido'}" Foreground="{DynamicResource PageForeground}" />
                                                                <TextBlock Text="Antigüedad laboral (meses)" FontSize="12" Foreground="{DynamicResource SubtleForeground}" />
                                                                <TextBlock Text="{Binding FinancialData.EmploymentSeniorityMonths, TargetNullValue='No obtenido'}" Foreground="{DynamicResource PageForeground}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Separator />
                                    <TextBlock Text="3. Evaluación crediticia" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PageForeground}" />
                                    <Border Background="{DynamicResource BorderPanelBackground}" Padding="15" CornerRadius="8">
                                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource PageForeground}" />
                                    </Border>
                                    <Button Classes="Primary" Content="Evaluar riesgo" Command="{Binding EvaluateCommand}" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{Binding CurrentApplication.Estado}" FontWeight="Bold" Foreground="{DynamicResource PageForeground}" />
                                    <TextBlock Text="{Binding CurrentApplication.EvaluationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" />
                                    <Border IsVisible="{Binding HasAssessment}" Background="{DynamicResource BorderPanelBackground}" CornerRadius="10" Padding="18">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Probabilidad estimada de morosidad grave a 24 meses" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource PageForeground}" />
                                            <TextBlock Text="{Binding AssessmentResult.ProbabilidadMorosidadGrave, StringFormat='{}{0:P2}'}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PageForeground}" />
                                            <TextBlock Text="{Binding AssessmentResult.NivelRiesgo, StringFormat='Nivel de riesgo: {0}'}" FontSize="18" TextWrapping="Wrap" Foreground="{DynamicResource PageForeground}" />
                                            <TextBlock Text="{Binding AssessmentResult.HorizonteMeses, StringFormat='Horizonte de evaluación: {0} meses'}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" />
                                            <TextBlock Text="{Binding AssessmentResult.EventoEvaluado, StringFormat='Evento evaluado: {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" />
                                            <TextBlock Text="{Binding AssessmentResult.VersionModelo, StringFormat='Versión del modelo: {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" />
                                            <TextBlock Text="{Binding AssessmentResult.Descripcion}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource MainPanelBackground}" CornerRadius="18" Padding="24" IsVisible="{Binding IsConfiguracionSection}">
                        <StackPanel Spacing="18">
                            <TextBlock Text="Configuración" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PageForeground}" />
                            <TextBlock Text="Tema de la aplicación" Foreground="{DynamicResource SecondaryForeground}" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

